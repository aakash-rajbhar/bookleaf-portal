NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookleaf
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# AI (server-side only!)
AI_PROVIDER=mock                     # gemini | mock
GEMINI_API_KEY=                      # leave empty or set to valid Gemini API key
GEMINI_MODEL=gemini-3.5-flash-lite   # default fast, reliable model
GEMINI_FALLBACK_MODEL=               # optional fallback model name (e.g. gemini-3.1-flash-lite)
AI_RPM_LIMIT=5                       # self-imposed calls/minute cap
AI_DAILY_LIMIT=200                   # self-imposed calls/day cap
AI_TIMEOUT_MS=20000                  # timeout in milliseconds
AI_MOCK_FAILURE=none                 # none | always | rate_limit | empty | invalid_json
# GEMINI_THINKING_BUDGET=0           # optional thinking tokens budget; omit if unset
