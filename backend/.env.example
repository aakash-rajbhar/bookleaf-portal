NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/bookleaf
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=8h
CORS_ORIGIN=http://localhost:5173

# AI (server-side only!)
AI_PROVIDER=gemini            # gemini | mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash # check Google AI Studio for current free-tier model names
AI_RPM_LIMIT=10               # self-imposed requests/minute cap
AI_TIMEOUT_MS=15000
